      "function": "apply_combined_pricing_strategies",
      "group": "استراتژی‌ها",
      "icon": "check",
      "description": "اعمال استراتژی قیمت‌گذاری انتخابی",
      "controlled_by": "selected_price_type"
    }
  ],
  "button_display_rules": {
    "selected_price_type": {
      "combined_discount_installment": ["قیمت‌گذاری ترکیبی", "مقایسه استراتژی‌ها", "اعمال قیمت‌گذاری ترکیبی"],
      "installment_only": ["قیمت‌گذاری ترکیبی"],
      "discount_only": ["قیمت‌گذاری ترکیبی"],
      "base_price": []
    },
    "user_role_restrictions": {
      "System Manager": "all",
      "Pricing Manager": ["essential_buttons", "advanced_buttons", "pricing_strategy_buttons"],
      "Sales User": ["essential_buttons", "report_buttons"]
    }
  }
}
